# Catálogo de variables de entorno del proyecto.
# Copia este archivo a .env y llena los valores reales (.env está gitignoreado).
# Al agregar una tool que use un secreto nuevo, declara aquí SOLO el nombre.

OPENAI_API_KEY=          # LLM OpenAI y embeddings de ChromaDB (necesaria incluso con Gemini como LLM)
GEMINI_API_KEY=          # LLM Gemini (opcional, solo si llm.provider = gemini)
SUPABASE_DB_URL=         # Connection string Postgres de Supabase con rol de SOLO lectura (ver CLAUDE.md)

# Opcionales: sobreescriben el modelo del YAML
# OPENAI_MODEL=
# GEMINI_MODEL=
